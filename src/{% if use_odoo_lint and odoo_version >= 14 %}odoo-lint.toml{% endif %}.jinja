# odoo-lint (odl): pylint-odoo's and OCA's checks for the addons in this repo.
# https://odoo-lint.readthedocs.io/en/latest/configuration.html
# It runs as an advisory pre-commit hook: it reports what it finds and never
# fails; pylint-odoo and the OCA checks stay the gate. The settings follow
# .pylintrc-mandatory.
target-version = "{{ "%.01f" | format(odoo_version) }}"
ignore = [
  # Not checked by oca-checks-po either (--disable=po-pretty-format): Odoo's
  # exports never match OCA's sort order.
  "PO007",
  {%- if convert_readme_fragments_to_markdown %}
  # The READMEs are README.md, generated by tools/obs_gen_addon_readme.py.
  "MOD005",
  {%- endif %}
]

[rules.manifest-required-author]
authors = ["{{ org_name }}"]

[rules.manifest-required-key]
keys = ["license"]

[rules.manifest-deprecated-key]
keys = ["description", "active"]

[rules.license-allowed]
allowed = [
  "AGPL-3",
  "GPL-2",
  "GPL-2 or any later version",
  "GPL-3",
  "GPL-3 or any later version",
  "LGPL-3",
]

[rules.manifest-version-format]
valid-odoo-versions = ["{{ "%.01f" | format(odoo_version) }}"]

# Checks across modules (ODOO004-ODOO007: fields in views, XML ids, models and
# fields named in Python) look up what a module's `depends` reach, so they need
# Odoo's source and the repo's dependencies on the addons path; without it they
# stay silent. Run them locally (<odoo> is your Odoo source checkout):
#   odl check --addons-path <odoo>/odoo/addons,<odoo>/addons
# or, where the Odoo source has a fixed place, set it here (relative to this
# file, globs allowed):
#   addons-path = ["../odoo/odoo/addons", "../odoo/addons"]
